# Generated by setup_dev.sh from gnupg/gpg-agent.conf.tmpl — do not edit directly.
# Re-run `bash setup_dev.sh` to regenerate; local edits here will be overwritten.

default-cache-ttl 28800
max-cache-ttl 28800

# gpg-agent requires an absolute path here and does NOT search PATH (a bare
# name fails with "ERR 67108949 No pinentry"), so this line is machine-specific
# and cannot be stowed verbatim — hence the template.
#
# setup_dev.sh prefers a TTY-independent pinentry. pinentry-tty and
# pinentry-curses write the prompt to the calling process's tty; when an agent
# rather than a human runs `git commit`, that tty is one the user cannot see or
# type into, so the commit hangs. pinentry-curses additionally refuses to draw
# in a small window ("Screen or window too small"). GUI pinentries have neither
# problem and can cache the passphrase in the OS keychain.
pinentry-program @PINENTRY_PROGRAM@
